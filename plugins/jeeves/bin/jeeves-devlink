#!/usr/bin/env bash
# Point the installed plugin cache at this checkout, so edits are live with no
# hand-syncing. Idempotent — safe to re-run after a plugin update clobbers the link.
#
#   jeeves-devlink            link the cache entry to this checkout
#   jeeves-devlink --status   print where the cache entry currently points
set -euo pipefail

# Resolve $0 through symlinks by hand — macOS's bash lacks `readlink -f`. A PATH
# entry (e.g. from jeeves-install-cli) is often a symlink to this script.
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
dev="$(cd "$(dirname "$self")/.." && pwd)"                    # bin/ → checkout root

# installed_plugins.json keys the cache dir by the plugin's declared version, so
# match that here; a plugin.json without one still falls back to "unknown".
version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$dev/.claude-plugin/plugin.json" 2>/dev/null | head -1)"
cache="$HOME/.claude/plugins/cache/jeeves-dev/jeeves/${version:-unknown}"

if [ "${1:-}" = "--status" ]; then
  if [ -L "$cache" ]; then echo "linked → $(readlink "$cache")"
  elif [ -e "$cache" ]; then echo "copy (not linked): $cache"
  else echo "absent: $cache"; fi
  exit 0
fi

mkdir -p "$(dirname "$cache")"
# Back up a real copy once; never clobber a prior backup or the checkout itself.
if [ -e "$cache" ] && [ ! -L "$cache" ]; then
  mv "$cache" "$cache.bak-$(date +%Y%m%d-%H%M%S)"
fi
rm -f "$cache"
ln -s "$dev" "$cache"
echo "linked → $(readlink "$cache")"
