{
  "name": "jeeves-cockpit",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Browser cockpit for the Jeeves orchestrator — PTY-backed spaces over a local server.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node server.mjs\" \"vite\"",
    "dev:server": "node server.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@mantine/core": "^7.13.0",
    "@mantine/hooks": "^7.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.47.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
