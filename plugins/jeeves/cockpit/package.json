{
  "name": "jeeves-cockpit",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Browser cockpit for the Jeeves orchestrator — PTY-backed spaces over a local server.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node server.mjs\" \"vite\"",
    "dev:server": "node server.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.48.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
